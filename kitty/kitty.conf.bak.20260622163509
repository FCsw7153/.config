# Font
font_family JetBrainsMono Nerd Font Mono
font_size 12.0

# Chinese fallback font
symbol_map U+2E80-U+2EFF,U+3000-U+303F,U+3400-U+4DBF,U+4E00-U+9FFF,U+F900-U+FAFF,U+FE10-U+FE1F,U+FE30-U+FE4F,U+FF00-U+FFEF PingFang SC

# Theme: Catppuccin Mocha
include current-theme.conf

# macOS titlebar
macos_titlebar_color background
macos_show_window_title_in menubar

# Tab bar
# The screenshot area is kitty's tab bar. This makes it cleaner and more Catppuccin-like.
tab_bar_edge top
tab_bar_style powerline
tab_powerline_style round
tab_bar_align left
tab_bar_margin_width 0.0
tab_bar_margin_height 0.0 0.0
tab_bar_show_new_tab_button yes
tab_title_max_length 24
tab_title_template " {title}  ⌘{index} "
active_tab_title_template " ● {title}  ⌘{index} "
active_tab_font_style bold
inactive_tab_font_style normal

# Tab shortcuts, Ghostty-like
map cmd+1 goto_tab 1
map cmd+2 goto_tab 2
map cmd+3 goto_tab 3
map cmd+4 goto_tab 4
map cmd+5 goto_tab 5
map cmd+6 goto_tab 6
map cmd+7 goto_tab 7
map cmd+8 goto_tab 8
map cmd+9 goto_tab 9
map cmd+] next_tab
map cmd+[ previous_tab
map cmd+t new_tab
map cmd+w close_tab
